---
import { WORKSPACE_TRANSITION_STORAGE_KEY } from "../lib/routeTransition";
import "../styles/global.css";

type Props = {
  title?: string;
  lang?: string;
};

const { title = "Sefkira Studio", lang = "en" } = Astro.props;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#101111" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <style is:inline>
      html.route-transition-pending body::after {
        display: none !important;
        content: none !important;
      }
    </style>
    <script is:inline define:vars={{ transitionStorageKey: WORKSPACE_TRANSITION_STORAGE_KEY }}>
      try {
        const noGridStyle = document.createElement("style");
        noGridStyle.textContent =
          "html.route-transition-pending body::after{display:none!important;content:none!important}";
        document.head.appendChild(noGridStyle);

        if (sessionStorage.getItem(transitionStorageKey) === "pending") {
          document.documentElement.classList.add("route-transition-pending");
        }
      } catch {
        document.documentElement.classList.remove("route-transition-pending");
      }
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Elms+Sans:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
