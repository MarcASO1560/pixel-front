---
import AppLayout from "../layouts/AppLayout.astro";
import WorkspaceLoadingTransition from "../features/navigation/components/WorkspaceLoadingTransition.vue";
import LifePlayground from "../features/workspace/components/LifePlayground.vue";

export const prerender = false;

const user = Astro.locals.user;
const userName = user?.username || user?.email || "";
---

<AppLayout title="Workspace | Sefkira Studio">
  <main class="workspace-shell">
    <LifePlayground client:load userName={userName} />
  </main>
  <WorkspaceLoadingTransition phase="entry" client:load />
</AppLayout>

<style>
  .workspace-shell {
    min-height: 0;
    height: 100vh;
    max-height: 100dvh;
    overflow: hidden;
    background:
      radial-gradient(circle at 18% 18%, rgba(201, 240, 222, 0.08), transparent 30%),
      radial-gradient(circle at 82% 24%, rgba(230, 210, 245, 0.08), transparent 28%),
      radial-gradient(circle at 52% 88%, rgba(225, 220, 170, 0.055), transparent 26%),
      #050505;
  }
</style>
