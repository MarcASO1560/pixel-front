---
import AppLayout from "../../layouts/AppLayout.astro";
import LifeBackground from "../../features/life-background/components/LifeBackground.astro";
import WorkspaceLoadingTransition from "../../features/navigation/components/WorkspaceLoadingTransition.vue";
import ProjectWorkspace from "../../features/workspace/components/ProjectWorkspace.vue";

export const prerender = false;

const { projectId = "" } = Astro.params;
const user = Astro.locals.user;
const userName = user?.username || user?.email || "";
const userUsername = user?.username || "";
const userAvatarUrl = user?.avatar_url || "";
const userEmail = user?.email || "";
const userPixelAvatar = user?.avatar_pixel_art || null;
---

<AppLayout title="Project | Sefkira Studio">
  <main class="studio-shell">
    <LifeBackground />
    <div class="studio-background-shade" aria-hidden="true"></div>
    <ProjectWorkspace
      client:load
      projectId={projectId}
      userName={userName}
      userUsername={userUsername}
      userAvatarUrl={userAvatarUrl}
      userEmail={userEmail}
      userPixelAvatar={userPixelAvatar}
    />
  </main>
  <WorkspaceLoadingTransition phase="entry" client:load />
</AppLayout>

<style>
  .studio-shell {
    position: relative;
    min-height: 0;
    height: 100vh;
    max-height: 100dvh;
    overflow: hidden;
    background: #050505;
    isolation: isolate;
  }

  .studio-background-shade {
    position: fixed;
    inset: 0;
    z-index: 3;
    background:
      linear-gradient(180deg, rgba(0, 0, 0, 0.5), rgba(0, 0, 0, 0.64)),
      radial-gradient(circle at 48% 36%, rgba(0, 0, 0, 0.04), rgba(0, 0, 0, 0.42) 68%);
    backdrop-filter: blur(12px) saturate(94%);
    pointer-events: none;
  }
</style>
